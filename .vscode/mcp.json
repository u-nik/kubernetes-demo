{
    "servers": {
        "vault": {
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-i",
                "-e",
                "VAULT_ADDR=http://host.docker.internal:8200",
                "-e",
                "VAULT_TOKEN=myroot",
                "hashicorp/vault-mcp-server:latest"
            ]
        },
        "kubernetes": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "kubernetes-mcp-server@latest"
            ]
        }
    }
}
